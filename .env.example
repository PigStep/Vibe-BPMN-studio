ENVIROMENT=prod|test|dev
PROVIDER_NAME=openrouter|gemini

# ==== OPENROUTER ====
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL_NAME=your_openrouter_model_name

# ==== GEMINI ====
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL_NAME=your_gemini_model_name

# ==== SITE ====
BASE_URL=http://127.0.0.1:8000/
API_URL=http://127.0.0.1:8000/api/
SITE_NAME=your_site_name #Optional. Usen in openrouter statistics

# ==== OTHER ====
DEBUG_MODE=false
LOG_LEVEL=INFO
